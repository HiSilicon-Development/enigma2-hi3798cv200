#!/bin/sh
# Install missing defaults only. Never replace a user's configuration or skins.
set -e
[ "$1" = configure ] || exit 0
ldconfig
mkdir -p /var/lib/opkg/info /var/lib/opkg/lists /etc/opkg /etc/tuxtxt

# Current builds use --sysconfdir=/etc. Retain the previous prefix layout and
# any existing symlinks; create aliases only where no path already exists.
if [ ! -e /etc/enigma2 ] && [ ! -L /etc/enigma2 ]; then
    if [ -d /usr/local/etc/enigma2 ]; then
        ln -s /usr/local/etc/enigma2 /etc/enigma2
    else
        mkdir -p /etc/enigma2
    fi
fi
if [ ! -e /usr/local/etc/enigma2 ] && [ ! -L /usr/local/etc/enigma2 ]; then
    mkdir -p /usr/local/etc
    ln -s /etc/enigma2 /usr/local/etc/enigma2
fi
# When both historical paths are real directories, keep /etc authoritative and
# import only missing legacy files. Neither tree (nor conflicting files) is lost.
if [ -d /usr/local/etc/enigma2 ] && [ -d /etc/enigma2 ] &&
   [ "$(readlink -f /usr/local/etc/enigma2)" != "$(readlink -f /etc/enigma2)" ]; then
    cp -an /usr/local/etc/enigma2/. /etc/enigma2/
fi
cp -an /usr/local/share/enigma2/defaults/enigma2/. /etc/enigma2/
# Enigma2's image default is Europe/Berlin. A Debian application must not reset
# an already configured host timezone on its first start.
if [ ! -e /etc/enigma2/settings ] && [ ! -L /etc/enigma2/settings ]; then
    zone=$(readlink -f /etc/localtime)
    case "$zone" in
        /usr/share/zoneinfo/*)
            zone=${zone#/usr/share/zoneinfo/}
            if [ -f "/usr/share/zoneinfo/$zone" ]; then
                case "$zone" in
                    */*) area=${zone%%/*}; zone=${zone#*/} ;;
                    *) area=Generic ;;
                esac
                printf 'config.timezone.area=%s\nconfig.timezone.val=%s\n' \
                    "$area" "$zone" > /etc/enigma2/settings
            fi
            ;;
    esac
fi
if [ ! -e /etc/enigma2/encoding.conf ] && [ ! -L /etc/enigma2/encoding.conf ]; then
    printf '* GB18030\n' > /etc/enigma2/encoding.conf
fi
if [ ! -e /etc/enigma2/userbouquet.favourites.tv ] && [ ! -L /etc/enigma2/userbouquet.favourites.tv ]; then
    printf '#NAME Favourites (TV)\n' > /etc/enigma2/userbouquet.favourites.tv
fi
if [ ! -e /etc/enigma2/userbouquet.favourites.radio ] && [ ! -L /etc/enigma2/userbouquet.favourites.radio ]; then
    printf '#NAME Favourites (Radio)\n' > /etc/enigma2/userbouquet.favourites.radio
fi

# Plugins contain /usr/share/enigma2 paths. Preserve existing directories and
# symlinks, linking only missing children rather than deleting a user's tree.
if [ ! -e /usr/share/enigma2 ] && [ ! -L /usr/share/enigma2 ]; then
    ln -s /usr/local/share/enigma2 /usr/share/enigma2
elif [ -d /usr/share/enigma2 ] && [ ! -L /usr/share/enigma2 ]; then
    for source in /usr/local/share/enigma2/*; do
        [ -e "$source" ] || continue
        target=/usr/share/enigma2/${source##*/}
        if [ ! -e "$target" ] && [ ! -L "$target" ]; then
            ln -s "$source" "$target"
        fi
    done
fi

# Retire regular files generated by the former procfs simulation. They are
# not device interfaces or user settings; leave any explicit symlinks alone.
for node in \
    /var/stb/vmpeg/0/pep_* /var/stb/vmpeg/0/smooth \
    /var/stb/vmpeg/0/xres /var/stb/vmpeg/0/yres /var/stb/vmpeg/0/aspect \
    /var/stb/vmpeg/0/framerate /var/stb/vmpeg/0/fallback_framerate \
    /var/stb/vmpeg/0/progressive /var/stb/vmpeg/0/dst_* \
    /var/stb/video/alpha /var/stb/video/aspect /var/stb/video/policy \
    /var/stb/video/policy2 /var/stb/video/policy_choices \
    /var/stb/video/videomode /var/stb/video/videomode_* \
    /var/stb/video/hdmi_colorspace /var/stb/video/hdmi_colorspace_choices \
    /var/stb/avs/0/input /var/stb/avs/0/input_choices /var/stb/avs/0/colorformat
do
    if [ -f "$node" ] && [ ! -L "$node" ]; then
        rm -f -- "$node"
    fi
done
systemctl enable e2.service 2>/dev/null || true
